[Unit]
Description=DEK review snapshot refresh from the proved active release

[Service]
Type=oneshot
User=dek-source-ingest
Group=dek-source-ingest
SupplementaryGroups=dek-release-read
WorkingDirectory=/var/empty/dek-source-ingest
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/dek-source-ingest/app/deploy/source_ingest_entrypoint.py --package-root /opt/dek-source-ingest/app refresh-active-bundle
SyslogIdentifier=dek-source-ingest
Nice=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
BindReadOnlyPaths=/var/lib/dek-activate/control:/run/dek-active-control /var/lib/dek-activate/releases:/run/dek-active-releases
ReadOnlyPaths=/opt/dek-source-ingest/app /var/lib/dek-source-ingest/vendor
ReadWritePaths=/var/lib/dek-review/input
InaccessiblePaths=/opt/dek-publisher /opt/dek-builder /opt/dek-activator /opt/dek-web /opt/dek-review /opt/dek-qa /var/lib/dek-publisher/secrets /var/lib/dek-git-auth /var/lib/dek-activate /var/spool/dek-build /etc/systemd/system /usr/lib/systemd /root
