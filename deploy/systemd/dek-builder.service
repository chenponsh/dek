[Unit]
Description=DEK credentialless networkless immutable release builder

[Service]
Type=oneshot
ExecCondition=+/usr/bin/python3 -I /opt/dek-builder/app/deploy/readiness.py --config /etc/dek-readiness.json --hmac-key /var/lib/dek-readiness/marker-hmac-key --validate-marker --marker /var/lib/dek-readiness/automation-ready
User=dek-builder
Group=dek-builder
SupplementaryGroups=dek-approved-read dek-qa-venv-read
WorkingDirectory=/var/empty/dek-builder
ExecStart=/usr/bin/python3 -I /opt/dek-builder/app/deploy/builder_entrypoint.py --config /etc/dek-builder.json
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadOnlyPaths=/opt/dek-builder/app /etc/dek-builder.json /var/spool/dek-build/approved /var/lib/dek-qa/venv /opt/dek-vendor/bin /opt/dek-qa/hermes-agent
ReadWritePaths=/var/lib/dek-builder/private /var/spool/dek-activate/builds /opt/dek-vendor/uv-cache
InaccessiblePaths=/var/lib/dek-git-auth /var/lib/dek-publisher/secrets /var/lib/dek-review /var/lib/dek-source-ingest /var/lib/dek-activate/control /var/lib/dek-web/secrets /var/lib/dek-qa/secrets /root /run/credentials
